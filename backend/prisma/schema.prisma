generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                   String    @id @default(uuid())
  name                 String
  legalName            String?
  logoUrl              String?
  website              String?
  description          String?
  registrationNumber   String?   @unique
  country              String
  isVerified           Boolean   @default(false)
  verifiedAt           DateTime?
  totalJobsPosted      Int       @default(0)
  totalEscrowsFunded   Int       @default(0)
  totalEscrowsReleased Int       @default(0)
  trustScore           Int       @default(0)
  isVerifiedPayer      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  email                String?   @unique
  walletAddress        String?   @unique
  smartAccountAddress  String?   @unique
  privyId              String?   @unique
  updatedAt            DateTime  @updatedAt
  jobPosts             JobPost[]

  @@map("companies")
}

model JobPost {
  id                      String       @id @default(uuid())
  companyId               String
  title                   String
  description             String
  location                String?
  employmentType          String?
  bonusAmount             Decimal      @db.Decimal(10, 2)
  currency                String       @default("USD")
  status                  JobStatus    @default(DRAFT)
  roleType                RoleType?
  seniorityLevel          Seniority?
  requiredSkills          String[]     @default([])
  escrowId                BigInt?      @unique
  escrowAddress           String?      @unique
  candidateWallet         String?
  escrowStatus            EscrowStatus @default(UNFUNDED)
  escrowFundedAt          DateTime?
  publishedAt             DateTime?
  closedAt                DateTime?
  createdAt               DateTime     @default(now())
  parsedRequirements      Json?
  dynamicWeights          Json?
  isWeb3Role              Boolean      @default(false)
  requirementsConfirmedAt DateTime?
  updatedAt               DateTime     @updatedAt
  company                 Company      @relation(fields: [companyId], references: [id])
  shortlists              Shortlist[]

  @@index([companyId, status, roleType])
  @@map("job_posts")
}

model Shortlist {
  id                   String           @id @default(uuid())
  jobPostId            String
  candidateId          String
  status               ShortlistStatus  @default(PENDING)
  roleFitScore         Float            @default(0)
  fraudTier            FraudTier        @default(CLEAN)
  riskLevel            RiskLevel?
  confidenceTier       ConfidenceTier?
  behaviorPattern      BehaviorPattern?
  fitTier              FitTier          @default(PASS)
  candidateNote        String?          @db.VarChar(280)
  hrNotes              String?
  appliedAt            DateTime         @default(now())
  frozenScorecard      Json?
  decisionCard         Json?
  gapReport            Json?
  pipelineStage        PipelineStage    @default(APPLIED)
  pipelineStageHistory Json?
  interviewQuestions   Json?
  updatedAt            DateTime         @updatedAt
  candidate            Candidate        @relation(fields: [candidateId], references: [id])
  jobPost              JobPost          @relation(fields: [jobPostId], references: [id])

  @@unique([jobPostId, candidateId])
  @@index([jobPostId, roleFitScore(sort: Desc)])
  @@map("shortlists")
}

model User {
  id              String        @id @default(uuid())
  email           String?       @unique
  username        String?       @unique
  firstName       String?
  lastName        String?
  name            String?
  role            UserRole      @default(CANDIDATE)
  accountStatus   AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)
  mfaEnabled      Boolean       @default(false)
  mfaSecret       String?
  mfaBackupCodes  String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  authAccounts    AuthAccount[]
  candidate       Candidate?

  @@map("users")
}

model AuthAccount {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String
  passwordHash String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("auth_accounts")
}

model Candidate {
  id                    String            @id @default(uuid())
  userId                String            @unique
  avatarUrl             String?
  bio                   String?           @db.VarChar(500)
  location              String?           @db.VarChar(255)
  website               String?           @db.VarChar(255)
  careerPath            Int               @default(1)
  generateCooldownUntil DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  devProfile            DeveloperProfile?
  shortlist             Shortlist[]
  vouches               Vouch[]

  @@map("candidates")
}

model DeveloperProfile {
  id                  String         @id @default(uuid())
  candidateId         String         @unique
  githubCooldownUntil DateTime?
  walletCooldownUntil DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  candidate           Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  githubProfile       GithubProfile?
  web3Profile         Web3Profile?

  @@map("developer_profiles")
}

model GithubProfile {
  id                 String            @id @default(uuid())
  developerProfileId String?           @unique
  githubUsername     String            @unique
  githubUserId       String            @unique
  encryptedToken     String
  scopes             String[]          @default([])
  syncStatus         SyncStatus        @default(NOT_SYNCED)
  syncError          String?
  lastSyncAt         DateTime?
  rawDataSnapshot    Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  syncProgress       Int               @default(0)
  installationId     String?
  scorecard          Json?
  scorecardUpdatedAt DateTime?
  analysis_jobs      AnalysisJob[]
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)

  @@map("github_profiles")
}

model Web3Profile {
  id                 String           @id @default(uuid())
  developerProfileId String           @unique
  solanaAddress      String?
  verifiedContracts  Json?
  onChainMetrics     Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)

  @@map("web3_profiles")
}

model Vouch {
  id            String    @id @default(uuid())
  candidateId   String
  voucherWallet String
  message       String    @db.VarChar(500)
  txSignature   String    @unique
  weight        String    @default("standard")
  isActive      Boolean   @default(true)
  flag          String?
  confirmedAt   DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, voucherWallet])
  @@index([candidateId, isActive, expiresAt])
  @@index([voucherWallet, isActive, expiresAt])
  @@map("vouches")
}

model AnalysisJob {
  id                  String                @id @default(uuid())
  status              String                @default("pending")
  input               Json
  result              Json?
  error               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  progress            Int                   @default(0)
  mode                AnalysisMode          @default(LIGHT)
  githubProfileId     String
  github_profiles     GithubProfile         @relation(fields: [githubProfileId], references: [id], onDelete: Cascade)
  evidence_primitives evidence_primitives[]

  @@map("analysis_jobs")
}

model CachedResult {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  result    Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("cached_results")
}

model EmployerLaunchWaitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  userId    String?
  createdAt DateTime @default(now())

  @@map("employer_launch_waitlist")
}

model EmployerWaitlist {
  id                  String   @id @default(uuid())
  email               String   @unique
  companyName         String
  website             String?
  rolesHiring         String[] @default([])
  usesGithub          Boolean  @default(false)
  evalTools           String?
  companyTypes        String[] @default([])
  teamSize            String?
  socialLinks         String?
  createdAt           DateTime @default(now())
  needsOtherRoleTools Boolean  @default(false)
  otherRolesText      String?

  @@map("employer_waitlist")
}

model CandidateInterestedWaitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  tools     String?
  createdAt DateTime @default(now())
  name      String?
  otherRole String?
  role      String?

  @@map("candidate_interested_waitlist")
}

model briefs {
  id             String   @id
  corpusId       String
  createdAt      DateTime @default(now())
  analysisConfig Json
  markdown       String
  analysisJson   Json
  pdfPath        String?
  isPartial      Boolean  @default(false)
  corpus         corpus   @relation(fields: [corpusId], references: [id])
}

model corpus {
  id                         String   @id
  githubUsername             String
  mode                       String
  collectedAt                DateTime @default(now())
  expiresAt                  DateTime
  groupsPresent              String[]
  collectionErrors           String[]
  identity                   Json?
  repositories               Json?
  commitSignals              Json?
  collaborationSignals       Json?
  engineeringPracticeSignals Json?
  impactSignals              Json?
  antiGamingInputs           Json?
  briefs                     briefs[]

  @@unique([githubUsername, mode])
  @@index([expiresAt])
  @@index([githubUsername])
}

model evidence_primitives {
  id            String          @id
  analysisJobId String
  primitive     PrimitiveType
  confidence    ConfidenceLevel
  evidenceText  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  analysis_jobs AnalysisJob     @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)

  @@index([analysisJobId])
  @@index([primitive, confidence])
}

model usage_events {
  id        String    @id @default(uuid())
  tenantId  String
  eventType String
  unitCount Float     @default(1.0)
  jobId     String?
  billedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([billedAt])
  @@map("usage_events")
}

enum JobStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  CLOSED_PENDING
  CLOSED
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum RoleType {
  BACKEND
  FRONTEND
  FULLSTACK
  INFRASTRUCTURE
  DATA_ML
  SMART_CONTRACT
  WEB3_BACKEND
  WEB3_FRONTEND
  WEB3_FULLSTACK
  DEFI_PROTOCOL
  SECURITY_WEB3
  SECURITY
  GENERALIST
}

enum EscrowStatus {
  UNFUNDED
  FUNDED
  RELEASED
  REFUNDED
}

enum FraudTier {
  CLEAN
  FLAGGED
  DISQUALIFIED
}

enum ShortlistStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  CONTACTED
  REJECTED
}

enum RiskLevel {
  LOW_RISK
  MEDIUM_RISK
  HIGH_RISK
  INSUFFICIENT_DATA
}

enum ConfidenceTier {
  FULL
  PARTIAL
  LOW
  MINIMAL
}

enum BehaviorPattern {
  REVIEW_HEAVY_SENIOR
  COMMIT_HEAVY_MIDLEVEL
  BALANCED_CONTRIBUTOR
  OSS_COLLABORATOR
  EARLY_CAREER
  RETURNING_DEVELOPER
  WEB3_SPECIALIST
}

enum FitTier {
  STRONG
  PROBE
  PASS
}

enum PipelineStage {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEW_HR
  INTERVIEW_TECHNICAL
  INTERVIEW_FINAL
  OFFER
  HIRED
  REJECTED
}

enum UserRole {
  CANDIDATE
  HR
  HR_ADMIN
  ORG_MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GITHUB
  GOOGLE
}

enum SyncStatus {
  NOT_SYNCED
  CONNECT_REQUEST
  CONNECT_SUCCESS
  SYNC_REQUEST
  SYNC_FETCH_REQUEST
  SYNC_FETCH_SUCCESS
  SYNC_SUCCESS
  SYNC_FAILED
}

enum AnalysisMode {
  LIGHT
  DEEP
}

enum ConfidenceLevel {
  STRONG_EVIDENCE
  MODERATE_EVIDENCE
  LOW_EVIDENCE
  OBSERVABILITY_GAP
  INSUFFICIENT_DATA
}

enum PrimitiveType {
  EXECUTION_RELIABILITY
  SYSTEMS_EVOLUTION
  COLLABORATION_LEVERAGE
  TECHNICAL_DEPTH
  OPERATIONAL_MATURITY
  AI_LEVERAGE_QUALITY
  AUTHENTICITY_CONFIDENCE
}
