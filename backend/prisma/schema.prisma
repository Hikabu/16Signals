generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  moduleFormat  = "cjs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String        @id @default(uuid())
  email           String?       @unique
  username        String?       @unique
  firstName       String?
  lastName        String?
  role            UserRole      @default(CANDIDATE)
  accountStatus   AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)
  mfaEnabled      Boolean       @default(false)
  mfaSecret       String?
  mfaBackupCodes  String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  authAccounts    AuthAccount[]

  candidate       Candidate?
  @@map("users")
}

model AuthAccount {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String
  passwordHash String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("auth_accounts")
}

model Company {
  id                   String    @id @default(uuid())
  name                 String
  legalName            String?
  logoUrl              String?
  website              String?
  description          String?
  registrationNumber   String?   @unique
  country              String
  createdAt            DateTime  @default(now())
  email                String?   @unique
  updatedAt            DateTime  @updatedAt

  @@map("companies")
}


model Candidate {
  id                    String            @id @default(uuid())
  userId                String            @unique
  avatarUrl             String?
  bio                   String?           @db.VarChar(500)
  location              String?           @db.VarChar(255)
  website               String?           @db.VarChar(255)
  careerPath            Int               @default(1)
  generateCooldownUntil DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  devProfile            DeveloperProfile?

  @@map("candidates")
}

model DeveloperProfile {
  id                  String         @id @default(uuid())
  candidateId         String         @unique
  githubCooldownUntil DateTime?
  walletCooldownUntil DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  candidate           Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  githubProfile       GithubProfile?
  web3Profile         Web3Profile?

  @@map("developer_profiles")
}

model GithubProfile {
  id                 String            @id @default(uuid())
  developerProfileId String?           @unique
  githubUsername     String            @unique
  githubUserId       String            @unique
  encryptedToken     String
  scopes             String[]          @default([])
  syncStatus         SyncStatus        @default(NOT_SYNCED)
  syncError          String?
  lastSyncAt         DateTime?
  rawDataSnapshot    Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  syncProgress       Int               @default(0)
  installationId     String?
  scorecard          Json?
  scorecardUpdatedAt DateTime?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)

  @@map("github_profiles")
}

model Web3Profile {
  id                 String           @id @default(uuid())
  developerProfileId String           @unique
  solanaAddress      String?
  verifiedContracts  Json?
  onChainMetrics     Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)

  @@map("web3_profiles")
}


model CachedResult {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  result    Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("cached_results")
}


model EmployerWaitlist {
  id                  String   @id @default(uuid())
  email               String   @unique
  companyName         String
  website             String?
  rolesHiring         String[] @default([])
  usesGithub          Boolean  @default(false)
  evalTools           String?
  companyTypes        String[] @default([])
  teamSize            String?
  socialLinks         String?
  createdAt           DateTime @default(now())

  @@map("employer_waitlist")
}

model usage_events {
  id        String    @id @default(uuid())
  tenantId  String
  eventType String
  unitCount Float     @default(1.0)
  jobId     String?
  billedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([billedAt])
  @@map("usage_events")
}


enum UserRole {
  CANDIDATE
  HR
  HR_ADMIN
  ORG_MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GITHUB
  GOOGLE
}

enum SyncStatus {
  NOT_SYNCED
  CONNECT_REQUEST
  CONNECT_SUCCESS
  SYNC_REQUEST
  SYNC_FETCH_REQUEST
  SYNC_FETCH_SUCCESS
  SYNC_SUCCESS
  SYNC_FAILED
}