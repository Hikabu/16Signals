{
  "openapi": "3.0.0",
  "paths": {
    "/sync/github/connect": {
      "get": {
        "description": "Generates a GitHub OAuth URL for the authenticated user and redirects them to GitHub authorization.",
        "operationId": "GithubSyncController_startConnect",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Redirects user to GitHub OAuth consent screen"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start GitHub connection",
        "tags": [
          "GitHub Sync"
        ]
      }
    },
    "/sync/github/connect/callback": {
      "get": {
        "description": "Handles GitHub OAuth callback and links GitHub account to the user profile, then triggers initial sync.",
        "operationId": "GithubSyncController_connectCallback",
        "parameters": [
          {
            "name": "state",
            "required": true,
            "in": "query",
            "description": "OAuth state parameter used for CSRF protection",
            "schema": {
              "example": "9f8a3c2d1b...",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirects user to frontend sync progress page"
          },
          "401": {
            "description": "Invalid or expired OAuth state"
          }
        },
        "summary": "GitHub OAuth callback (connect flow)",
        "tags": [
          "GitHub Sync"
        ]
      }
    },
    "/sync/github": {
      "post": {
        "description": "Manually triggers a sync of GitHub data for the authenticated user. Requires GitHub to be connected. This step is required before generating a scorecard for a signed in user",
        "operationId": "GithubSyncController_triggerSync",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sync job successfully queued or executed"
          },
          "401": {
            "description": "Invalid or missing JWT token"
          },
          "409": {
            "description": "GitHub account not connected. Frontend should redirect to connect flow."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Sync Github before scorecard generation",
        "tags": [
          "GitHub Sync"
        ]
      }
    },
    "/sync/github/status": {
      "get": {
        "description": "Returns current sync state including progress, errors, and last sync timestamp.",
        "operationId": "GithubSyncController_getSyncStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current sync status retrieved successfully"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get GitHub sync status",
        "tags": [
          "GitHub Sync"
        ]
      }
    },
    "/sync/github/dev/unsync": {
      "delete": {
        "operationId": "GithubSyncController_unsyncGithub",
